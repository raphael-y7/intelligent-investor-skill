{
  "skill": "stock-bond-allocation-skill",
  "version": "1.0.0",
  "test_cases": [
    {
      "id": "should-trigger-01",
      "type": "should_trigger",
      "prompt": "一百万本金，股票和债券怎么分配？",
      "expected_behavior": "给25%~75%区间，标准对半开",
      "notes": "正面：大类配置"
    },
    {
      "id": "should-trigger-02",
      "type": "should_trigger",
      "prompt": "股票涨到快七成了，要不要减一点？",
      "expected_behavior": "机械再平衡：55%卖1/11，或越界5个百分点",
      "notes": "正面：再平衡触发"
    },
    {
      "id": "should-trigger-03",
      "type": "should_trigger",
      "prompt": "年轻人是不是可以满仓股票、一只债券都不买？",
      "expected_behavior": "六项前置条件逐项核查，否则回75%上限",
      "notes": "正面：全仓请求"
    },
    {
      "id": "should-trigger-04",
      "type": "should_trigger",
      "prompt": "听说配置要按100减年龄，我40岁该六成股票吗？",
      "expected_behavior": "否定100−年龄，年龄非判据",
      "notes": "正面：流行公式纠偏"
    },
    {
      "id": "should-not-trigger-01",
      "type": "should_not_trigger",
      "prompt": "沪深300现在贵不贵，整体估值什么水平？",
      "expected_behavior": "应转 market-valuation-check-skill",
      "notes": "跨skill混淆：水位≠比例"
    },
    {
      "id": "should-not-trigger-02",
      "type": "should_not_trigger",
      "prompt": "每月定投两千，选什么标的、什么频率？",
      "expected_behavior": "应转 router 下 dca-index-portfolio",
      "notes": "跨skill混淆：定投≠配置"
    },
    {
      "id": "edge-01",
      "type": "edge_case",
      "prompt": "我怕通胀，所以想把钱全买成股票抗通胀，对吗？",
      "expected_behavior": "通胀不为全仓辩护，保留两类资产",
      "notes": "边界：理由包装的破限"
    }
  ]
}