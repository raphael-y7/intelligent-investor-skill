{
  "skill": "defensive-stock-screen-skill",
  "version": "1.0.0",
  "test_cases": [
    {
      "id": "should-trigger-01",
      "type": "should_trigger",
      "prompt": "帮我按格雷厄姆的标准筛一批防御型股票",
      "expected_behavior": "四规则+七项统计标准逐项打分",
      "notes": "正面：标准筛股"
    },
    {
      "id": "should-trigger-02",
      "type": "should_trigger",
      "prompt": "这只白马股符合防御型投资者的选股标准吗？",
      "expected_behavior": "七项逐条核验，含市盈率×市净率≤22.5",
      "notes": "正面：单股核验"
    },
    {
      "id": "should-trigger-03",
      "type": "should_trigger",
      "prompt": "组合只有8只股票够不够分散？整体还看什么指标？",
      "expected_behavior": "10~30只＋组合盈利收益率≥债息",
      "notes": "正面：组合层规则"
    },
    {
      "id": "should-not-trigger-01",
      "type": "should_not_trigger",
      "prompt": "这家公司老计提一次性费用，利润可信吗？",
      "expected_behavior": "应转 eps-quality-check-skill",
      "notes": "跨skill混淆：筛选≠辨伪"
    },
    {
      "id": "should-not-trigger-02",
      "type": "should_not_trigger",
      "prompt": "什么是市盈率？",
      "expected_behavior": "概念问答，不触发",
      "notes": "诱饵：概念解释"
    },
    {
      "id": "edge-01",
      "type": "edge_case",
      "prompt": "能不能把22.5那条放宽一点，我真的很看好这家公司",
      "expected_behavior": "拒绝放宽，价格关是特性不是缺陷",
      "notes": "边界：为标的求情"
    }
  ]
}